---
interface Props {
  current: "Adelie" | "Gentoo" | "Chinstrap";
}

const { current } = Astro.props as Props;

const species = [
  {
    name: "Adelie",
    href: "/Especes/Adelie"
  },
  {
    name: "Gentoo",
    href: "/Especes/Gentoo"
  },
  {
    name: "Chinstrap",
    href: "/Especes/Chinstrap"
  }
];
---

<nav
  class="mt-8 flex flex-wrap items-center gap-3"
  aria-label="Navigation entre les espèces"
>
  {
    species.map((item) => (
      <a
        href={item.href}
        aria-current={current === item.name ? "page" : undefined}
        class:list={[
          "rounded-full px-5 py-2.5 text-sm font-medium transition",
          "focus-visible:ring-4 focus-visible:ring-[#a33b59]",

          current === item.name
            ? "bg-[#7f1d3a] text-[#f4e9e3]"
            : "bg-[#21131b] text-[#d8bfc5] ring-1 ring-[#4b2936] hover:bg-[#3a202c]"
        ]}
      >
        {item.name}
      </a>
    ))
  }

  <a
    href="/Especes/Slider"
        class="ml-0 rounded-full bg-[#2d1a24] px-5 py-2.5
          text-sm font-medium text-[#f4e9e3] transition
          hover:bg-[#7f1d3a] md:ml-3"
  >
    Vue avec slider →
  </a>
</nav>
