---
import * as Plot from "@observablehq/plot";

import PlotFigure from "./PlotFigure.astro";
import penguins from "../data/penguins.json";

interface Props {
  species: "Adelie" | "Gentoo" | "Chinstrap";
}

const { species } = Astro.props as Props;
---

<div
  class="rounded-3xl border border-slate-200
         bg-white p-5 shadow-sm md:p-10"
>
  <PlotFigure
    options={{
      width: 900,

      title: `Morphologie des manchots ${species}`,

      subtitle:
        "Longueur et profondeur du bec",

      caption:
        `Seuls les manchots de l'espèce ${species} sont affichés.`,

      ariaLabel:
        `Nuage de points représentant uniquement les manchots ${species}.`,

      ariaDescription:
        `Le graphique compare la longueur et la profondeur du bec des manchots appartenant à l'espèce ${species}.`,

      x: {
        label: "Longueur du bec (mm)",
        grid: true
      },

      y: {
        label: "Profondeur du bec (mm)",
        grid: true
      },

      marks: [
        Plot.dot(penguins, {
          filter: (d) => d.species === species,

          x: "culmen_length_mm",
          y: "culmen_depth_mm",

          fill: "species",

          r: 5,
          opacity: 0.8,

          title: (d) =>
            `${d.species}
Bec : ${d.culmen_length_mm} × ${d.culmen_depth_mm} mm`
        })
      ]
    }}
  />
</div>
