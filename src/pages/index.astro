---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Data Explorer — TP2">

  <main class="mx-auto max-w-7xl px-6 py-16 lg:px-10">

    <!-- ================================================== -->
    <!-- HERO                                               -->
    <!-- ================================================== -->

    <section
      class="flex min-h-[65vh] flex-col justify-center"
    >

      <p
        class="mb-5 text-sm font-bold uppercase
               tracking-[0.2em] text-[#b34d68]"
      >
        Astro × Observable Plot
      </p>

      <h1
        class="max-w-5xl text-6xl font-bold
               leading-[0.95] tracking-tight
               text-[#f4e9e3] md:text-8xl"
      >
        Explorer les données

        <span class="block text-[#b34d68]">
          autrement.
        </span>
      </h1>

      <p
        class="mt-8 max-w-2xl text-lg
               leading-8 text-[#c2aeb3]"
      >
        Le TP2 reprend les visualisations du premier TP
        et teste différentes façons de naviguer et
        d'explorer les données avec Observable Plot.
      </p>

      <a
        href="#tp2"
        class="mt-8 w-fit rounded-full
               bg-[#2d1a24] px-6 py-3
               font-medium text-[#f4e9e3]
               transition
               motion-safe:hover:-translate-y-1
               hover:bg-[#7f1d3a]
               focus-visible:outline-4
               focus-visible:outline-offset-4
               focus-visible:outline-[#d06a80]"
      >
        Découvrir le TP2 ↓
      </a>

    </section>


    <!-- ================================================== -->
    <!-- TP2                                                -->
    <!-- ================================================== -->

    <section
      id="tp2"
      class="py-24"
      aria-labelledby="tp2-title"
    >

      <p
        class="mb-3 text-sm font-bold uppercase
               tracking-[0.2em] text-[#b34d68]"
      >
        TP2
      </p>

      <h2
        id="tp2-title"
        class="max-w-4xl text-4xl font-bold
               tracking-tight text-[#f4e9e3]
               md:text-6xl"
      >
        Deux façons de naviguer
        entre les graphiques
      </h2>

      <p
        class="mt-6 max-w-2xl
               text-lg leading-8
               text-[#c2aeb3]"
      >
        Le dataset Penguins est utilisé pour tester
        deux structures différentes : plusieurs pages
        indépendantes et une page unique avec ancres
        et slider horizontal.
      </p>


      <div class="mt-12 grid gap-6 md:grid-cols-2">

        <!-- ================================================== -->
        <!-- UNE PAGE PAR GRAPHIQUE                             -->
        <!-- ================================================== -->

        <a
          href="/Especes/Adelie"
          class="group flex min-h-107.5
                 flex-col justify-between
                 rounded-3xl border border-[#4b2936]
                 bg-[#21131b] p-8
                 transition duration-300
                 motion-safe:hover:-translate-y-2
                 hover:bg-[#2d1a24]
                 hover:shadow-xl
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#d06a80]"
        >

          <div class="flex justify-between">

            <span
              class="font-bold text-[#b34d68]"
            >
              01
            </span>

            <span
              class="text-2xl transition
                     motion-safe:group-hover:-translate-y-1
                     motion-safe:group-hover:translate-x-1"
              aria-hidden="true"
            >
              ↗
            </span>

          </div>


          <div>

            <p
              class="mb-3 text-sm font-bold
                     uppercase tracking-[0.15em]
                     text-[#b34d68]"
            >
              Une page par graphique
            </p>

            <h3
              class="text-4xl font-bold
                     tracking-tight
                     text-[#f4e9e3]
                     md:text-5xl"
            >
              Trois espèces,
              trois pages.
            </h3>

            <p
              class="mt-5 max-w-md
                     leading-7
                     text-[#c2aeb3]"
            >
              Adelie, Gentoo et Chinstrap disposent
              chacune de leur propre route Astro
              et d'une navigation commune.
            </p>

          </div>


          <span
            class="text-sm text-[#a98b96]"
          >
            Pages multiples · filtre Observable Plot
          </span>

        </a>


        <!-- ================================================== -->
        <!-- SLIDER                                             -->
        <!-- ================================================== -->

        <a
          href="/Especes/Slider"
          class="group flex min-h-107.5
                 flex-col justify-between
                 rounded-3xl border border-[#4b2936]
                 bg-[#21131b] p-8
                 transition duration-300
                 motion-safe:hover:-translate-y-2
                 hover:bg-[#2d1a24]
                 hover:shadow-xl
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#d06a80]"
        >

          <div class="flex justify-between">

            <span
              class="font-bold text-[#b34d68]"
            >
              02
            </span>

            <span
              class="text-2xl transition
                     motion-safe:group-hover:-translate-y-1
                     motion-safe:group-hover:translate-x-1"
              aria-hidden="true"
            >
              ↗
            </span>

          </div>


          <div>

            <p
              class="mb-3 text-sm font-bold
                     uppercase tracking-[0.15em]
                     text-[#b34d68]"
            >
              Une seule page
            </p>

            <h3
              class="text-4xl font-bold
                     tracking-tight
                     text-[#f4e9e3]
                     md:text-5xl"
            >
              Ancres & slider.
            </h3>

            <p
              class="mt-5 max-w-md
                     leading-7
                     text-[#c2aeb3]"
            >
              Les trois graphiques sont regroupés
              dans un slider horizontal avec
              un menu dynamique.
            </p>

          </div>


          <span
            class="text-sm text-[#a98b96]"
          >
            Ancres · CSS Scroll Snap · IntersectionObserver
          </span>

        </a>

      </div>

    </section>


    <!-- ================================================== -->
    <!-- BONUS TP2                                          -->
    <!-- ================================================== -->

    <section
      id="bonus"
      class="border-y border-[#35202a]
             py-24"
      aria-labelledby="bonus-title"
    >

      <p
        class="mb-3 text-sm font-bold uppercase
               tracking-[0.2em] text-[#b34d68]"
      >
        Bonus du TP2
      </p>


      <h2
        id="bonus-title"
        class="max-w-4xl text-4xl font-bold
               tracking-tight text-[#f4e9e3]
               md:text-6xl"
      >
        Aller plus loin dans
        <span class="block text-[#b34d68]">
          l'exploration des données.
        </span>
      </h2>


      <p
        class="mt-6 max-w-2xl
               text-lg leading-8
               text-[#c2aeb3]"
      >
        Les trois datasets sont repris dans des versions
        enrichies avec statistiques, plusieurs visualisations
        et interactions permettant de changer de lecture.
      </p>


      <div
        class="mt-14 grid gap-6
               lg:grid-cols-3"
      >

        <!-- ================================================== -->
        <!-- PENGUINS BONUS                                     -->
        <!-- ================================================== -->

        <a
          href="/Especes/Adelie"
          class="group flex min-h-105
                 flex-col justify-between
                 rounded-3xl
                 border border-[#63384a]
                 bg-[#21131b]
                 p-8
                 transition duration-300
                 motion-safe:hover:-translate-y-2
                 hover:border-[#e890b0]
                 hover:shadow-xl
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#e890b0]"
        >

          <div>

            <div
              class="flex items-center
                     justify-between"
            >

              <span
                class="font-bold
                       text-[#e890b0]"
              >
                01
              </span>

              <span
                class="h-3 w-3
                       rounded-full
                       bg-[#e890b0]"
                aria-hidden="true"
              >
              </span>

            </div>


            <p
              class="mt-14 text-sm
                     font-bold uppercase
                     tracking-[0.15em]
                     text-[#c17a94]"
            >
              Penguins
            </p>


            <h3
              class="mt-3 text-4xl
                     font-bold
                     tracking-tight
                     text-[#fff7fa]"
            >
              Explorer les espèces
            </h3>


            <p
              class="mt-5 leading-7
                     text-[#cdbbc2]"
            >
              Morphologie du bec, masse corporelle
              et longueur des nageoires avec statistiques
              et visualisations interactives.
            </p>

          </div>


          <span
            class="mt-10 font-semibold
                   text-[#e890b0]"
          >
            Voir l'exploration →
          </span>

        </a>


        <!-- ================================================== -->
        <!-- CARS BONUS                                         -->
        <!-- ================================================== -->

        <a
          href="/explorer/cars"
          class="group flex min-h-105
                 flex-col justify-between
                 rounded-3xl
                 border border-[#32495a]
                 bg-[#111b23]
                 p-8
                 transition duration-300
                 motion-safe:hover:-translate-y-2
                 hover:border-[#72a7cf]
                 hover:shadow-xl
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#72a7cf]"
        >

          <div>

            <div
              class="flex items-center
                     justify-between"
            >

              <span
                class="font-bold
                       text-[#72a7cf]"
              >
                02
              </span>

              <span
                class="h-3 w-3
                       rounded-full
                       bg-[#72a7cf]"
                aria-hidden="true"
              >
              </span>

            </div>


            <p
              class="mt-14 text-sm
                     font-bold uppercase
                     tracking-[0.15em]
                     text-[#9fc3dd]"
            >
              Cars
            </p>


            <h3
              class="mt-3 text-4xl
                     font-bold
                     tracking-tight
                     text-[#f5f9fc]"
            >
              Explorer les performances
            </h3>


            <p
              class="mt-5 leading-7
                     text-[#b8cbd8]"
            >
              Puissance, économie de carburant,
              répartition du poids et évolution
              des véhicules dans le temps.
            </p>

          </div>


          <span
            class="mt-10 font-semibold
                   text-[#72a7cf]"
          >
            Voir l'exploration →
          </span>

        </a>


        <!-- ================================================== -->
        <!-- PIZZA BONUS                                        -->
        <!-- ================================================== -->

        <a
          href="/explorer/pizza"
          class="group flex min-h-105
                 flex-col justify-between
                 rounded-3xl
                 border border-[#5b372d]
                 bg-[#211613]
                 p-8
                 transition duration-300
                 motion-safe:hover:-translate-y-2
                 hover:border-[#e2875d]
                 hover:shadow-xl
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#e2875d]"
        >

          <div>

            <div
              class="flex items-center
                     justify-between"
            >

              <span
                class="font-bold
                       text-[#e2875d]"
              >
                03
              </span>

              <span
                class="h-3 w-3
                       rounded-full
                       bg-[#e2875d]"
                aria-hidden="true"
              >
              </span>

            </div>


            <p
              class="mt-14 text-sm
                     font-bold uppercase
                     tracking-[0.15em]
                     text-[#e8ad91]"
            >
              Pizza
            </p>


            <h3
              class="mt-3 text-4xl
                     font-bold
                     tracking-tight
                     text-[#fff7f2]"
            >
              Explorer les ventes
            </h3>


            <p
              class="mt-5 leading-7
                     text-[#d5bcb2]"
            >
              Revenus par catégorie, habitudes
              de commande et classement des pizzas
              les plus populaires.
            </p>

          </div>


          <span
            class="mt-10 font-semibold
                   text-[#e2875d]"
          >
            Voir l'exploration →
          </span>

        </a>

      </div>

    </section>


    <!-- ================================================== -->
    <!-- TP1                                                -->
    <!-- ================================================== -->

    <section
      class="py-24"
      aria-labelledby="tp1-title"
    >

      <p
        class="mb-3 text-sm font-bold uppercase
               tracking-[0.2em] text-[#b34d68]"
      >
        TP1
      </p>

      <h2
        id="tp1-title"
        class="text-4xl font-bold
               tracking-tight
               text-[#f4e9e3]
               md:text-6xl"
      >
        Explorations précédentes
      </h2>

      <p
        class="mt-6 max-w-2xl
               text-lg leading-8
               text-[#c2aeb3]"
      >
        Les premières explorations réalisées avec
        Observable Plot restent accessibles telles
        qu'elles ont été construites dans le TP1.
      </p>


      <div
        class="mt-12 grid gap-6
               md:grid-cols-3"
      >

        <!-- ================================================== -->
        <!-- PENGUINS TP1                                       -->
        <!-- ================================================== -->

        <a
          href="/penguins"
          class="rounded-3xl
                 border border-[#4b2936]
                 bg-[#21131b]
                 p-8
                 transition
                 motion-safe:hover:-translate-y-1
                 hover:shadow-lg
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#d06a80]"
        >

          <span
            class="text-sm font-bold
                   text-[#b34d68]"
          >
            01
          </span>

          <h3
            class="mt-16 text-3xl
                   font-bold
                   text-[#f4e9e3]"
          >
            Penguins
          </h3>

          <p
            class="mt-4 leading-7
                   text-[#c2aeb3]"
          >
            Morphologie et caractéristiques
            des manchots.
          </p>

        </a>


        <!-- ================================================== -->
        <!-- CARS TP1                                           -->
        <!-- ================================================== -->

        <a
          href="/cars"
          class="rounded-3xl
                 border border-[#4b2936]
                 bg-[#21131b]
                 p-8
                 transition
                 motion-safe:hover:-translate-y-1
                 hover:shadow-lg
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#d06a80]"
        >

          <span
            class="text-sm font-bold
                   text-[#b34d68]"
          >
            02
          </span>

          <h3
            class="mt-16 text-3xl
                   font-bold
                   text-[#f4e9e3]"
          >
            Cars
          </h3>

          <p
            class="mt-4 leading-7
                   text-[#c2aeb3]"
          >
            Consommation, puissance
            et poids des voitures.
          </p>

        </a>


        <!-- ================================================== -->
        <!-- PIZZA TP1                                          -->
        <!-- ================================================== -->

        <a
          href="/pizza"
          class="rounded-3xl
                 border border-[#4b2936]
                 bg-[#21131b]
                 p-8
                 transition
                 motion-safe:hover:-translate-y-1
                 hover:shadow-lg
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#d06a80]"
        >

          <span
            class="text-sm font-bold
                   text-[#b34d68]"
          >
            03
          </span>

          <h3
            class="mt-16 text-3xl
                   font-bold
                   text-[#f4e9e3]"
          >
            Pizza
          </h3>

          <p
            class="mt-4 leading-7
                   text-[#c2aeb3]"
          >
            Commandes, revenus
            et habitudes de consommation.
          </p>

        </a>

      </div>

    </section>

  </main>

</Layout>