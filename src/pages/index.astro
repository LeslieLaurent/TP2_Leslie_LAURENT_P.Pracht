---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Data Explorer — TP2">

  <main class="mx-auto max-w-7xl px-6 py-16 lg:px-10">

    <!-- HERO -->

    <section
      class="flex min-h-[65vh] flex-col justify-center"
    >

      <p
        class="mb-5 text-sm font-bold uppercase
               tracking-[0.2em] text-emerald-700"
      >
        Astro × Observable Plot
      </p>

      <h1
        class="max-w-5xl text-6xl font-bold
               leading-[0.95] tracking-tight
               text-slate-900 md:text-8xl"
      >
        Explorer les données
        <span class="block text-emerald-700">
          autrement.
        </span>
      </h1>

      <p
        class="mt-8 max-w-2xl text-lg
               leading-8 text-slate-600"
      >
        Le TP2 reprend les visualisations du premier TP
        et teste deux méthodes différentes de navigation
        entre plusieurs graphiques.
      </p>

      <a
        href="#tp2"
        class="mt-8 w-fit rounded-full
               bg-slate-900 px-6 py-3
               font-medium text-white
               transition
               hover:-translate-y-1
               hover:bg-emerald-700"
      >
        Découvrir le TP2 ↓
      </a>

    </section>


    <!-- TP2 -->

    <section
      id="tp2"
      class="py-24"
      aria-labelledby="tp2-title"
    >

      <p
        class="mb-3 text-sm font-bold uppercase
               tracking-[0.2em] text-emerald-700"
      >
        TP2
      </p>

      <h2
        id="tp2-title"
        class="max-w-4xl text-4xl font-bold
               tracking-tight text-slate-900
               md:text-6xl"
      >
        Deux façons de naviguer entre les graphiques
      </h2>


      <div class="mt-12 grid gap-6 md:grid-cols-2">

        <!-- PLUSIEURS PAGES -->

        <a
          href="/Especes/Adelie"
          class="group flex min-h-[430px]
                 flex-col justify-between
                 rounded-3xl border border-slate-200
                 bg-white p-8 transition duration-300
                 hover:-translate-y-2
                 hover:bg-slate-900
                 hover:text-white
                 hover:shadow-xl"
        >

          <div class="flex justify-between">

            <span
              class="font-bold text-emerald-700"
            >
              01
            </span>

            <span
              class="text-2xl transition
                     group-hover:-translate-y-1
                     group-hover:translate-x-1"
              aria-hidden="true"
            >
              ↗
            </span>

          </div>


          <div>

            <p
              class="mb-3 text-sm font-bold
                     uppercase tracking-[0.15em]
                     text-emerald-700"
            >
              Une page par graphique
            </p>

            <h3
              class="text-4xl font-bold
                     tracking-tight md:text-5xl"
            >
              Trois espèces,
              trois pages.
            </h3>

            <p
              class="mt-5 max-w-md leading-7
                     text-slate-600
                     group-hover:text-slate-300"
            >
              Adelie, Gentoo et Chinstrap disposent
              chacune de leur propre route Astro.
            </p>

          </div>


          <span
            class="text-sm text-slate-500
                   group-hover:text-slate-400"
          >
            Pages multiples · menu de navigation
          </span>

        </a>


        <!-- SLIDER -->

        <a
          href="/Especes/Slider"
          class="group flex min-h-[430px]
                 flex-col justify-between
                 rounded-3xl border border-slate-200
                 bg-white p-8 transition duration-300
                 hover:-translate-y-2
                 hover:bg-slate-900
                 hover:text-white
                 hover:shadow-xl"
        >

          <div class="flex justify-between">

            <span
              class="font-bold text-emerald-700"
            >
              02
            </span>

            <span
              class="text-2xl transition
                     group-hover:-translate-y-1
                     group-hover:translate-x-1"
              aria-hidden="true"
            >
              ↗
            </span>

          </div>


          <div>

            <p
              class="mb-3 text-sm font-bold
                     uppercase tracking-[0.15em]
                     text-emerald-700"
            >
              Une seule page
            </p>

            <h3
              class="text-4xl font-bold
                     tracking-tight md:text-5xl"
            >
              Ancres & slider.
            </h3>

            <p
              class="mt-5 max-w-md leading-7
                     text-slate-600
                     group-hover:text-slate-300"
            >
              Les trois graphiques sont regroupés dans
              un slider horizontal avec un menu dynamique.
            </p>

          </div>


          <span
            class="text-sm text-slate-500
                   group-hover:text-slate-400"
          >
            Ancres · CSS Scroll Snap · IntersectionObserver
          </span>

        </a>

      </div>

    </section>


    <!-- RAPPEL TP1 -->

    <section
      class="py-24"
      aria-labelledby="tp1-title"
    >

      <p
        class="mb-3 text-sm font-bold uppercase
               tracking-[0.2em] text-emerald-700"
      >
        TP1
      </p>

      <h2
        id="tp1-title"
        class="text-4xl font-bold
               tracking-tight text-slate-900
               md:text-6xl"
      >
        Explorations précédentes
      </h2>


      <div
        class="mt-12 grid gap-6 md:grid-cols-3"
      >

        <a
          href="/penguins"
          class="rounded-3xl border border-slate-200
                 bg-white p-8 transition
                 hover:-translate-y-1
                 hover:shadow-lg"
        >
          <span
            class="text-sm font-bold text-emerald-700"
          >
            01
          </span>

          <h3
            class="mt-16 text-3xl font-bold
                   text-slate-900"
          >
            Penguins
          </h3>

          <p
            class="mt-4 leading-7 text-slate-600"
          >
            Morphologie et caractéristiques des manchots.
          </p>
        </a>


        <a
          href="/cars"
          class="rounded-3xl border border-slate-200
                 bg-white p-8 transition
                 hover:-translate-y-1
                 hover:shadow-lg"
        >
          <span
            class="text-sm font-bold text-emerald-700"
          >
            02
          </span>

          <h3
            class="mt-16 text-3xl font-bold
                   text-slate-900"
          >
            Cars
          </h3>

          <p
            class="mt-4 leading-7 text-slate-600"
          >
            Consommation, puissance et poids des voitures.
          </p>
        </a>


        <a
          href="/pizza"
          class="rounded-3xl border border-slate-200
                 bg-white p-8 transition
                 hover:-translate-y-1
                 hover:shadow-lg"
        >
          <span
            class="text-sm font-bold text-emerald-700"
          >
            03
          </span>

          <h3
            class="mt-16 text-3xl font-bold
                   text-slate-900"
          >
            Pizza
          </h3>

          <p
            class="mt-4 leading-7 text-slate-600"
          >
            Commandes, revenus et habitudes de consommation.
          </p>
        </a>

      </div>

    </section>

  </main>

</Layout>