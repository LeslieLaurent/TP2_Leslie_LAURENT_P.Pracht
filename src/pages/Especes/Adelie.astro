---
import Layout from "../../layouts/Layout.astro";
import GraphicSpecies from "../../components/GraphicSpecies.astro";
import SpeciesMenu from "../../components/SpeciesMenu.astro";
---

<Layout title="Adelie — TP2 Observable Plot">

  <main class="mx-auto max-w-6xl px-6 py-16 lg:px-10">

    <a
      href="/"
            class="text-sm font-medium text-[#a98b96] transition
              hover:text-[#d06a80]"
    >
      ← Retour à l'accueil
    </a>


    <SpeciesMenu current="Adelie" />


    <section class="py-20">

      <p
        class="mb-4 text-sm font-bold uppercase tracking-[0.2em]
               text-[#b34d68]"
      >
        TP2 · Espèce 01
      </p>

      <h1
        class="text-6xl font-bold tracking-tight
               text-[#f4e9e3] md:text-8xl"
      >
        Adelie
      </h1>

      <p
        class="mt-6 max-w-2xl text-lg leading-8
               text-[#c2aeb3]"
      >
        Cette première méthode utilise une page Astro dédiée
        à chaque espèce de manchot.
      </p>

    </section>


    <section class="pb-20">

      <GraphicSpecies species="Adelie" />

    </section>

  </main>

</Layout>