---
import Layout from "../../layouts/Layout.astro";
import GraphicSpecies from "../../components/GraphicSpecies.astro";
import SpeciesMenu from "../../components/SpeciesMenu.astro";
---

<Layout title="Gentoo — TP2 Observable Plot">

  <main class="mx-auto max-w-6xl px-6 py-16 lg:px-10">

    <a
      href="/"
      class="text-sm font-medium text-slate-500 transition
             hover:text-emerald-700"
    >
      ← Retour à l'accueil
    </a>


    <SpeciesMenu current="Gentoo" />


    <section class="py-20">

      <p
        class="mb-4 text-sm font-bold uppercase tracking-[0.2em]
               text-emerald-700"
      >
        TP2 · Espèce 02
      </p>

      <h1
        class="text-6xl font-bold tracking-tight
               text-slate-900 md:text-8xl"
      >
        Gentoo
      </h1>

      <p
        class="mt-6 max-w-2xl text-lg leading-8
               text-slate-600"
      >
        Cette page affiche uniquement les individus appartenant
        à l'espèce Gentoo.
      </p>

    </section>


    <section class="pb-20">

      <GraphicSpecies species="Gentoo" />

    </section>

  </main>

</Layout>